{
  "name": "@tenancy-node/orm-sequelize",
  "version": "0.8.0",
  "description": "Sequelize integration for tenancy-node (instance per tenant and Umzug migrator)",
  "keywords": [
    "multi-tenancy",
    "multitenancy",
    "multi-tenant",
    "saas",
    "tenancy",
    "tenant",
    "orm",
    "database",
    "sequelize"
  ],
  "license": "MIT",
  "homepage": "https://yedrick.github.io/tenat-node/",
  "bugs": {
    "url": "https://github.com/yedrick/tenat-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yedrick/tenat-node.git",
    "directory": "packages/orm-sequelize"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@tenancy-node/core": "workspace:^",
    "@tenancy-node/db": "workspace:^",
    "umzug": "^3.8.3"
  },
  "peerDependencies": {
    "sequelize": ">=6"
  },
  "devDependencies": {
    "sequelize": "^6.37.8",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "@tenancy-node/db-postgres": "workspace:^",
    "kysely": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
