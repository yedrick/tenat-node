{
  "name": "@tenancy-node/otel",
  "version": "0.8.0",
  "description": "OpenTelemetry traces and metrics for tenancy-node",
  "keywords": [
    "multi-tenancy",
    "multitenancy",
    "multi-tenant",
    "saas",
    "tenancy",
    "tenant",
    "opentelemetry",
    "tracing",
    "observability",
    "otel"
  ],
  "license": "MIT",
  "homepage": "https://yedrick.github.io/tenat-node/",
  "bugs": {
    "url": "https://github.com/yedrick/tenat-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yedrick/tenat-node.git",
    "directory": "packages/otel"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@tenancy-node/core": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
