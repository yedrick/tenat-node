{
  "name": "@tenancy-node/admin-ui",
  "version": "0.8.0",
  "description": "Admin panel UI for tenancy-node (React SPA served by @tenancy-node/admin-api)",
  "keywords": [
    "multi-tenancy",
    "multitenancy",
    "multi-tenant",
    "saas",
    "tenancy",
    "tenant",
    "admin",
    "dashboard",
    "ui"
  ],
  "license": "MIT",
  "homepage": "https://yedrick.github.io/tenat-node/",
  "bugs": {
    "url": "https://github.com/yedrick/tenat-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yedrick/tenat-node.git",
    "directory": "packages/admin-ui"
  },
  "type": "module",
  "files": [
    "dist",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts"
  ],
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.6",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.7",
    "@testing-library/jest-dom": "^6.6.3"
  },
  "module": "./index.js",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
