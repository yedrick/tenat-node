{
  "name": "@tenancy-node/adapter-express",
  "version": "0.8.0",
  "description": "Express middleware for tenancy-node",
  "keywords": [
    "multi-tenancy",
    "multitenancy",
    "multi-tenant",
    "saas",
    "tenancy",
    "tenant",
    "middleware",
    "express"
  ],
  "license": "MIT",
  "homepage": "https://yedrick.github.io/tenat-node/",
  "bugs": {
    "url": "https://github.com/yedrick/tenat-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yedrick/tenat-node.git",
    "directory": "packages/adapter-express"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@tenancy-node/core": "workspace:^"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0"
  },
  "devDependencies": {
    "express": "^5.0.1",
    "@types/express": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
