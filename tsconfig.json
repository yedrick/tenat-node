{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@tenancy-node/*": ["packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "examples/*/src",
    "examples/*/test",
    "vitest.config.ts"
  ],
  "exclude": ["packages/admin-ui/src", "packages/admin-ui/test/**/*.tsx"]
}
